# Copy to .env.local and fill in. Do NOT commit .env.local.

# --- Vercel AI Gateway (AI SDK) ---
# Create a key at https://vercel.com/dashboard -> AI Gateway, or run `vercel env pull`.
# On Vercel deployments this is provided automatically via OIDC; only needed for local dev.
AI_GATEWAY_API_KEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth0 ---
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# --- Resend ---
RESEND_API_KEY=

# --- /api/sim guard (required in production; optional locally) ---
SIM_SECRET=

# --- Vercel Sandbox local auth ---
# Deployed Vercel Functions can use Vercel runtime auth automatically.
# For local Sandbox runs, set either VERCEL_OIDC_TOKEN or all three explicit values.
VERCEL_OIDC_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
